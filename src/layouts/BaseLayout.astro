---
/**
 * Single layout for every page.
 * Nav = 4 items per DECISIONS D4 · no Guestbook in nav/footer (D9).
 * Theme = PHP-style blue–purple, polite/trustworthy (PROFILE ## Tone).
 */
import { loadProfile } from '../lib/profile';

interface Props {
  title?: string;
  description?: string;
}
const profile = loadProfile();
const { title = profile.name, description = profile.headline } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'หน้าแรก', active: path === '/' },
  { href: '/about', label: 'เกี่ยวกับผม', active: path.startsWith('/about') },
  { href: '/interests', label: 'ทักษะและความสนใจ', active: path.startsWith('/interests') },
  { href: '/contact', label: 'ติดต่อ', active: path.startsWith('/contact') },
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #f6f6fb;
        --surface: #ffffff;
        --text: #1d1f3b;
        --muted: #4a4d6b;
        --accent: #4f5b93;
        --accent-strong: #3b4478;
        --accent-soft: #eceefa;
        --php: #777bb4;
        --border: #dcdff0;
        --danger: #9b2c2c;
        --ok: #276749;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        font-family: "Segoe UI", "Noto Sans Thai", "Sarabun", system-ui, sans-serif;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        line-height: 1.6;
      }
      a { color: var(--accent); }
      a:hover { color: var(--accent-strong); }
      :focus-visible { outline: 3px solid var(--php); outline-offset: 2px; }
      .wrap { width: min(880px, 92vw); margin: 0 auto; }
      main { flex: 1; padding: 1.5rem 0 3rem; }
      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 1.25rem 1.5rem;
        margin: 1rem 0;
      }
      h1, h2, h3 { line-height: 1.3; color: var(--text); }
      h1 { font-size: clamp(1.5rem, 5vw, 2.25rem); margin: 0.25rem 0 0.75rem; }
      p, li { color: var(--muted); }
      .eyebrow { margin: 0; color: var(--accent); font-weight: 700; letter-spacing: 0.02em; }

      .site-header {
        background: linear-gradient(90deg, var(--accent-strong), var(--php));
      }
      .site-header .wrap {
        display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
        gap: 0.5rem 1rem; padding: 0.75rem 0;
      }
      .brand { color: #fff; font-weight: 700; text-decoration: none; }
      .brand:hover { color: #fff; }
      nav ul { display: flex; flex-wrap: wrap; gap: 0.25rem 0.5rem; list-style: none; margin: 0; padding: 0; }
      nav a {
        display: inline-block; padding: 0.35rem 0.6rem; border-radius: 8px;
        color: #eef0ff; font-weight: 600; text-decoration: none;
      }
      nav a:hover { background: rgba(255, 255, 255, 0.15); color: #fff; }
      nav a[aria-current="page"] { background: #fff; color: var(--accent-strong); }

      .btn {
        display: inline-block; padding: 0.7rem 1.2rem; border-radius: 10px;
        font-weight: 700; text-decoration: none; border: 2px solid var(--accent);
      }
      .btn-primary { background: var(--accent); color: #fff; }
      .btn-primary:hover { background: var(--accent-strong); border-color: var(--accent-strong); color: #fff; }
      .btn-secondary { background: transparent; color: var(--accent); }
      .btn-secondary:hover { background: var(--accent-soft); }
      .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }

      input, textarea, button {
        font: inherit; border-radius: 10px; border: 1px solid var(--border);
        background: #fff; color: var(--text); padding: 0.7rem 0.9rem; width: 100%;
      }
      /* Field boundary ≥ 3:1 on white (WCAG 1.4.11 · QA A11Y-1); --border is 1.32:1. */
      input, textarea { border-color: #8589b3; }
      button {
        background: var(--accent); color: #fff; font-weight: 700; cursor: pointer;
        width: auto; border-color: var(--accent);
      }
      button:hover { background: var(--accent-strong); }
      button[disabled] { opacity: 0.6; cursor: wait; }
      label { display: block; margin: 0.75rem 0 0.35rem; color: var(--text); font-weight: 600; }
      .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
      .muted-small { font-size: 0.9rem; color: var(--muted); }

      .site-footer { border-top: 1px solid var(--border); padding: 1.25rem 0; }
      .site-footer p { margin: 0; font-size: 0.9rem; }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">{profile.name}</a>
        <nav aria-label="เมนูหลัก">
          <ul>
            {links.map((l) => (
              <li><a href={l.href} aria-current={l.active ? 'page' : undefined}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>© {year} {profile.name}</p>
      </div>
    </footer>
  </body>
</html>
