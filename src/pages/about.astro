---
/**
 * About — every Bio paragraph from PROFILE (DECISIONS D8 · open loop L2 fixed in profile.ts).
 */
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile } from '../lib/profile';
const profile = loadProfile();
---
<BaseLayout title={`เกี่ยวกับผม · ${profile.name}`} description={profile.headline}>
  <article class="card">
    <p class="eyebrow">เกี่ยวกับผม</p>
    <h1>{profile.name}</h1>
    {profile.bioParagraphs.map((para) => <p>{para}</p>)}
    <div class="actions">
      <a class="btn btn-primary" href="/contact">ติดต่อผม</a>
    </div>
  </article>
</BaseLayout>
