---
/**
 * Contact — DECISIONS D5 (mailto link text "ส่งอีเมล", address never printed as text,
 * placeholder channels not rendered), D6 (501/error keeps the typed message + points to email),
 * D11 (privacy microcopy). Backend (POST /api/contact) is owned by the backend agent.
 */
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile } from '../lib/profile';
const profile = loadProfile();
const { email, github, linkedin } = profile.contact;
const mailto = email ? `mailto:${email}` : '';
---
<BaseLayout title={`ติดต่อ · ${profile.name}`} description={profile.headline}>
  <section class="card">
    <h1>ติดต่อผม</h1>
    <p>สนใจคุยเรื่องงานเว็บหรือระบบหลังบ้าน ส่งอีเมลหรือฝากข้อความไว้ได้เลยครับ</p>
    <ul class="channels">
      {mailto && <li><a class="btn btn-primary" href={mailto}>ส่งอีเมล</a></li>}
      {github && <li><a class="btn btn-secondary" href={github} rel="noopener noreferrer" target="_blank">GitHub</a></li>}
      {linkedin && <li><a class="btn btn-secondary" href={linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a></li>}
    </ul>
  </section>

  <section class="card" aria-labelledby="form-h">
    <h2 id="form-h">ฝากข้อความ</h2>
    <form id="contact-form" data-mailto={mailto}>
      <label for="name">ชื่อ (Name)</label>
      <input id="name" name="name" required maxlength="80" autocomplete="name" />
      <label for="email">อีเมลของคุณ (Email)</label>
      <input id="email" name="email" type="email" required maxlength="120" autocomplete="email" />
      <label for="message">ข้อความ (Message)</label>
      <textarea id="message" name="message" rows="5" required maxlength="2000"></textarea>
      <p class="muted-small">ใช้ข้อมูลนี้เพื่อตอบกลับคุณเท่านั้น</p>
      <p><button type="submit">ส่งข้อความ</button></p>
      <p id="status" role="status" aria-live="polite"></p>
    </form>
  </section>
</BaseLayout>

<style>
  .channels { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; flex-wrap: wrap; gap: 0.75rem; }
  h2 { font-size: 1.2rem; margin-top: 0; }
  #status { font-weight: 600; min-height: 1.6em; }
  #status[data-kind="ok"] { color: var(--ok); }
  #status[data-kind="error"] { color: var(--danger); }
  #status a { color: inherit; }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('status');
  const button = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
  const mailto = form?.dataset.mailto || '';

  function show(kind: 'ok' | 'error' | 'info', text: string, withEmailLink = false) {
    if (!status) return;
    status.dataset.kind = kind;
    status.textContent = text;
    if (withEmailLink && mailto) {
      const a = document.createElement('a');
      a.href = mailto;
      a.textContent = 'ส่งอีเมล';
      status.append(' ', a);
    }
  }

  // D6: on 501 / any error the typed message stays in the fields — only reset on success.
  const NOT_READY = 'ระบบส่งข้อความยังไม่พร้อม — ส่งอีเมลหาผมได้เลย ข้อความของคุณยังอยู่ในช่อง';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const payload = Object.fromEntries(new FormData(form).entries());
    show('info', 'กำลังส่ง…');
    if (button) button.disabled = true;
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        form.reset();
        show('ok', 'ส่งข้อความแล้ว ขอบคุณครับ');
      } else if (res.status === 400) {
        show('error', 'กรุณาตรวจชื่อ อีเมล และข้อความอีกครั้ง ข้อความของคุณยังอยู่ในช่อง');
      } else {
        show('error', NOT_READY, true);
      }
    } catch {
      show('error', NOT_READY, true);
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
